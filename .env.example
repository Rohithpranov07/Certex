# HMAC key for signing certificates. REQUIRED outside development.
# Unset => a fixed development key is used and certificates carry "dev_key": true.
CERTEX_KEY=
# Default engine profile for CLI and API: cpython | pcre2 | java | none
CERTEX_PROFILE=cpython
# Per-pattern analysis wall-clock limit in seconds (M3 returns UNKNOWN past it)
CERTEX_TIMEOUT=2.0
# Step-budget constant c in budget = c * (m+1) * (n+1)^power + 64
CERTEX_BUDGET_C=8
# Wall-clock limit (seconds) for one engine replay subprocess
CERTEX_REPLAY_WALL=20
